  "syllabusHighlights": [
    {
      "level": 200,
      "part": "Part II",
      "department": "Pharmaceutics",
      "topics": [
        "Pharmaceutical calculations and introductory unit operations",
        "Disperse systems: emulsions, suspensions, gels and aerosols",
        "Introduction to solid and liquid dosage forms, flavouring and colouring",
        "Microbial morphology, cultivation, growth and death curves",
        "Quantitative bacterial analysis, microbial metabolism, viruses, systematics and introductory parasitology",
        "Practical weighing, mixing, size reduction and stock-solution preparation"
      ]
    },
    {
      "level": 200,
      "part": "Part II",
      "department": "Pharmacognosy",
      "topics": [
        "Scope, classification and taxonomy of drugs",
        "Plant morphology, anatomy, plant cells and cell contents",
        "Organised vegetable drugs including Digitalis, Senna, Cinchona, Rauwolfia, Catharanthus roseus, Cannabis sativa, ginger and clove",
        "Unorganised drugs, fibres and surgical dressings",
        "Macroscopy, microscopy and chemical tests"
      ]
    },
    {
      "level": 200,
      "part": "Part II",
      "department": "Pharmacology",
      "topics": [
        "Blood and body fluids",
        "Cardiovascular, renal, respiratory and alimentary systems",
        "Autonomic and central nervous systems",
        "Reproductive system",
        "Introductory tissue and histology practicals"
      ]
    },
    {
      "level": 200,
      "part": "Part II",
      "department": "Pharmaceutical Chemistry",
      "topics": [
        "Inorganic pharmaceuticals and metal ions in biology",
        "Solutions, solubility, colligative properties and phase equilibria",
        "Electrochemistry, acids and bases, buffers, Henderson–Hasselbalch equation, conductivity and potentiometry",
        "Reaction kinetics and thermodynamics",
        "Organic bonding, electronic effects, functional groups, nomenclature and stereochemistry",
        "Acidity, basicity, isomerism and organic reactivity",
        "Volumetric, limit, colorimetric, refractometric and potentiometric analysis"
      ]
    },
    {
      "level": 300,
      "part": "Part III",
      "department": "Biochemistry",
      "topics": [
        "Chemistry of carbohydrates, lipids, proteins, nucleic acids and nucleoproteins",
        "pH, buffers, enzymes and coenzymes",
        "Bioenergetics and carbohydrate, lipid, amino-acid, purine, pyrimidine and nucleotide metabolism",
        "Electron transport and oxidative phosphorylation",
        "Nucleic-acid and protein biosynthesis, metabolic regulation and hormones"
      ]
    },
    {
      "level": 300,
      "part": "Part III",
      "department": "Chemical Pathology",
      "topics": [
        "Cellular adaptation, injury and cell death",
        "Inflammation, immunity, neoplasia and genetic and immunological factors",
        "Fungal, viral, parasitic, sexually transmitted and other infectious diseases",
        "Nutritional deficiencies and endocrine, metabolic, neurological and emotional disorders",
        "Adverse drug reactions"
      ]
    },
    {
      "level": 300,
      "part": "Part III",
      "department": "Pharmaceutics",
      "topics": [
        "Colloidal and disperse systems, micelles, solubilisation, emulsions, suspensions and semi-solids",
        "Sterilisation principles, equipment, heat, radiation, filtration, gas and chemical methods",
        "Sterilisation controls and asepsis",
        "Prescription reading, extemporaneous compounding and hospital dispensing",
        "Pharmaceutical water, pyrogens and pyrogen testing",
        "Sterile products, sterility testing and microbial testing"
      ]
    },
    {
      "level": 300,
      "part": "Part III",
      "department": "Pharmacognosy",
      "topics": [
        "Extraction by maceration, percolation, continuous hot extraction and partition",
        "Paper chromatography, TLC, HPLC, GC, electrophoresis, column and other separation techniques",
        "Natural products and biosynthesis",
        "Carbohydrates, glycosides, amino acids, peptides, purines, pyrimidines, vitamins and alkaloids",
        "Acetate/propionate-derived drugs, polyketides, isoprenoids, steroids, terpenoids, essential oils and shikimates"
      ]
    },
    {
      "level": 300,
      "part": "Part III",
      "department": "Pharmacology",
      "topics": [
        "Drug-action theories, agonists, antagonists, affinity and therapeutic index",
        "Bioassay, ADME and introductory pharmacokinetics",
        "Cholinergic, adrenergic and neuromuscular transmission",
        "Cardiovascular pharmacology, antihypertensives, diuretics, vasodilators, antianginals and antiarrhythmics",
        "Autacoids including histamine, serotonin, prostaglandins and leukotrienes",
        "Endocrinology and sex hormones"
      ]
    },
    {
      "level": 300,
      "part": "Part III",
      "department": "Pharmaceutical Chemistry",
      "topics": [
        "Radiopharmacy, radiation types, radioisotope production, decay, detection, handling and disposal",
        "Diagnostic and therapeutic radionuclides",
        "Polarimetry, refractometry and electroanalytical methods",
        "Polarography and UV, IR, fluorimetry, NMR and mass spectroscopy"
      ]
    },
    {
      "level": 400,
      "part": "Part IV",
      "department": "Clinical Pharmacy and Pharmacy Administration",
      "topics": [
        "History of pharmacy in Nigeria and pharmacy ethics",
        "Pharmacy laws and regulation, NAFDAC, NDLEA, dangerous drugs, drug advertisements and registration",
        "Management principles, human resources, finance, stores, stock and layout",
        "Community pharmacy establishment, location analysis, marketing, pricing, inventory and cash control",
        "Biopharmaceutics, drug metabolism and pharmacokinetic models",
        "Sustained-release and multiple-dose regimens, bioequivalence, pharmacogenetics and biostatistics"
      ]
    },
    {
      "level": 400,
      "part": "Part IV",
      "department": "Pharmaceutics",
      "topics": [
        "Solid-state properties, polymorphism and micromeritics",
        "Particle size, surface area, bulk density and powder flow",
        "Tabletting, coating, sustained release, capsules and microencapsulation",
        "Disinfectants, antiseptics, preservatives and multiphase preservation",
        "Microbial genetics and industrial fermentation"
      ]
    },
    {
      "level": 400,
      "part": "Part IV",
      "department": "Pharmacognosy",
      "topics": [
        "Traditional medicine principles and standardisation of herbal remedies",
        "Safety, efficacy and integration with modern medicine",
        "Screening Nigerian medicinal plants for bioactive agents",
        "Research guidelines, trends and plant field trips"
      ]
    },
    {
      "level": 400,
      "part": "Part IV",
      "department": "Pharmacology",
      "topics": [
        "CNS neurotransmitters and local and general anaesthetics",
        "Analgesics, opiates, anxiolytics, sedatives and hypnotics",
        "Antipsychotics, extrapyramidal disorders, antidepressants and antiepileptics",
        "Chemotherapy: antiparasitics, antimicrobials, antineoplastics, antimalarials and antivirals",
        "Drug resistance and combination therapy"
      ]
    },
    {
      "level": 400,
      "part": "Part IV",
      "department": "Pharmaceutical Chemistry",
      "topics": [
        "Oxidising and reducing reagents",
        "Five- and six-membered heterocyclic chemistry",
        "Photochemistry and photostability",
        "Physicochemical and receptor factors including pKa, conformation and stereochemistry",
        "Steroids, vitamins and medicinal chemistry",
        "Structure–activity relationships, synthesis, stability and assay of selected drug classes"
      ]
    },
    {
      "level": 500,
      "part": "Part V",
      "department": "Clinical Pharmacy and Clinical Pharmacology",
      "topics": [
        "Individualising dosage regimens in renal and hepatic disease, altered protein binding, paediatrics, geriatrics and pregnancy/lactation",
        "Drug literature evaluation, drug information centres, hospital formularies and patient counselling",
        "Hospital, ward, outpatient, community and health-centre clerkships",
        "Prescription scrutiny, medication profiles, therapeutic drug monitoring, adverse reactions, interactions and toxicity",
        "Clinical pharmacology across major organ systems and phases I–IV clinical trials"
      ]
    },
    {
      "level": 500,
      "part": "Part V",
      "department": "Pharmaceutics",
      "topics": [
        "Plant and premises design, unit operations and pilot equipment",
        "Heat and momentum transfer, milling, mixing, filtration, evaporation and drying",
        "Tabletting, filling, capping, GMP, cosmetic manufacturing and industrial visits",
        "Blood and blood products, plasma substitutes and immunology",
        "Hypersensitivity, transplantation, vaccines and immunoglobulins",
        "Advanced drug delivery, prodrugs, controlled release, targeted systems and multiple/micro-emulsions"
      ]
    },
    {
      "level": 500,
      "part": "Part V",
      "department": "Pharmacognosy",
      "topics": [
